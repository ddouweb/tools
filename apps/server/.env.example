# 后端运行配置（复制为 .env 后按需修改）
PORT=3000

# 平台核心（见 docs/specs/0002-platform-core.md）
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-in-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Script Adapter（见 docs/specs/0001-script-adapter.md）
# 允许的运行时白名单（逗号分隔）。默认仅 node（默认最小开放）；
# 按需添加：powershell,cmd,bash,sh,python
SCRIPT_ALLOWED_RUNTIMES=node
# 允许按路径执行的目录白名单（逗号分隔）；留空则禁止按路径执行（仅允许内联脚本）
SCRIPT_ALLOWED_DIRS=
# timeoutMs 全局上限（毫秒）
SCRIPT_MAX_TIMEOUT_MS=600000
